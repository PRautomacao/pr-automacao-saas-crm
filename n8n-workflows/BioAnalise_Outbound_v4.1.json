{
  "name": "Bio Análise - Outbound Chatwoot → WhatsApp v4.1",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bio-analise-chatwoot-outbound",
        "options": {}
      },
      "id": "9c24fe74-ec48-4fb7-93ff-c3acdfac67e3",
      "name": "Webhook_Chatwoot_Outbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "webhookId": "bio-analise-cw-outbound"
    },
    {
      "parameters": {
        "jsCode": "const raw=$input.item.json;\n// Chatwoot envia diferentes estruturas dependendo da versão\nconst event=raw.event||raw.type||'';\nif(!['message_created','message_updated'].includes(event))return[];\n\nconst data=raw.data||raw;\nconst msgType=data.message_type;  // 0=incoming, 1=outgoing, 2=activity\nconst isPrivate=Boolean(data.private);\nconst sender=data.sender||{};\nconst senderType=String(sender.type||'').toLowerCase();\n\n// Só processa mensagens SAINDO (agent→cliente), não privadas, de agent/administrator\nif(msgType!==1)return[];\nif(isPrivate)return[];\nif(!['agent','administrator'].includes(senderType))return[];\n\nconst conversation=data.conversation||{};\nconst contact=conversation.contact||{};\nconst phone=String(contact.phone_number||'').replace(/\\D/g,'');\nif(!phone)return[];\n\nconst convId=String(conversation.id||data.conversation_id||'');\nif(!convId)return[];\n\nreturn[{json:{\n  ...raw,\n  _cw_event:event,\n  _cw_message_id:String(data.id||''),\n  _cw_conv_id:convId,\n  _cw_content:String(data.content||''),\n  _cw_sender_name:String(sender.name||'Atendente'),\n  _cw_sender_type:senderType,\n  _contact_phone:phone,\n  _contact_name:String(contact.name||'Cliente')\n}}];"
      },
      "id": "77cc3410-5274-44b4-9c2c-ac7a499ba2cb",
      "name": "Filtro_Chatwoot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/atendimentos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "chatwoot_conversation_id",
              "value": "=eq.{{ $json._cw_conv_id }}"
            },
            {
              "name": "select",
              "value": "conversation_id,telefone,paciente_id,agendamento_nome,contexto"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "id": "9b56fbfc-5735-4780-9392-731f4c81e32f",
      "name": "Buscar_Atendimento_Por_Conv",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Recebe resultado do Supabase\nconst raw=$json;\nconst items=Array.isArray(raw)?raw:[];\nconst atend=items[0]||null;\nconst item=$('Filtro_Chatwoot').item.json;\nif(!atend){\n  // Não encontrou atendimento — tentar construir conversation_id a partir do telefone\n  return[{json:{...item,_atend_found:false,\n    phone_jid:item._contact_phone+'@s.whatsapp.net',\n    evo_instance:$env.EVO_INSTANCE||'',\n    conversation_id:'wa_'+item._contact_phone\n  }}];\n}\nreturn[{json:{...item,_atend_found:true,\n  phone_jid:atend.telefone?atend.telefone+'@s.whatsapp.net':(item._contact_phone+'@s.whatsapp.net'),\n  evo_instance:$env.EVO_INSTANCE||'',\n  conversation_id:atend.conversation_id||('wa_'+item._contact_phone),\n  paciente_id:atend.paciente_id||null,\n  paciente_nome:atend.agendamento_nome||(atend.contexto&&atend.contexto.paciente_nome)||item._contact_name\n}}];"
      },
      "id": "2162b132-bac7-4113-b7d4-31a8dd4fefde",
      "name": "Montar_Payload_Outbound",

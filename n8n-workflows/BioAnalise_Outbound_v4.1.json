    {
      "parameters": {
        "jsCode": "const item=$input.item.json;\n// Payload para marcar human_active = true no Supabase\nreturn[{json:{\n  ...item,\n  human_update_payload:{\n    human_active:true,\n    current_owner:'human',\n    current_status:'human_attending',\n    last_human_message:item._cw_content,\n    last_human_sender:item._cw_sender_name,\n    updated_at:new Date().toISOString()\n  }\n}}];"
      },
